# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://ofm_user:change_me_in_production@localhost:5433/ofm_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_dev_only
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payments (fans pay the platform through the provider, creators are paid by SEPA transfer)
# fake = local payment simulator (default outside production), ccbill = CCBill
PAYMENT_PROVIDER=fake
# Platform fee on prices excluding VAT (percent), editable from /admin/settings
PLATFORM_FEE_PERCENTAGE=15
# Days a creator earning stays on hold before it can be paid out
EARNINGS_HOLD_DAYS=7
MINIMUM_PAYOUT_AMOUNT=50
# CCBill (only with PAYMENT_PROVIDER=ccbill), see docs/PAIEMENTS.md
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUBACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_DATALINK_USERNAME=
CCBILL_DATALINK_PASSWORD=
# Secret appended to the webhook URL configured at CCBill: /api/v1/webhooks/payments/ccbill?token=...
CCBILL_WEBHOOK_TOKEN=
# Platform bank account debited by the SEPA payout files
PAYOUT_DEBTOR_NAME=
PAYOUT_DEBTOR_IBAN=
PAYOUT_DEBTOR_BIC=
# Encryption of sensitive data at rest (creators' IBAN). Keep it secret and backed up:
# changing or losing it makes stored IBANs unreadable. openssl rand -base64 32
DATA_ENCRYPTION_KEY=dev-only-encryption-key-change-me

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=ofm-content-dev
AWS_REGION=eu-west-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

# MinIO (Local S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_only
MINIO_USE_SSL=false

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ofm.com
SMTP_FROM_NAME=FanVIP

# Email (SendGrid Production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key

# Email notes:
# - Leave SMTP_HOST empty to log emails to the console instead of sending them
#   (emails are never sent when NODE_ENV=test).
# - SMTP_SECURE=true forces TLS (defaults to true only when SMTP_PORT=465).
# - Links in emails (verification, password reset) point to WEB_URL.
SMTP_SECURE=false

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
# Leave empty to disable web push delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ofm.com

# Twilio (SMS/2FA)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Content Security
WATERMARK_TEXT=FanVIP
WATERMARK_ENABLED=true
MAX_FILE_SIZE_MB=500
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm
ALLOWED_AUDIO_FORMATS=mp3,wav,aac,m4a

# Content Moderation
CONTENT_MODERATION_ENABLED=true
NSFW_DETECTION_ENABLED=true
CSAM_DETECTION_ENABLED=true

# Session
SESSION_SECRET=your-session-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Feature Flags
ENABLE_LIVE_STREAMING=false
ENABLE_CRYPTO_PAYMENTS=false
ENABLE_STORIES=false
ENABLE_MESSAGING=true

# RabbitMQ
RABBITMQ_URL=amqp://ofm_user:rabbitmq_password_dev_only@localhost:5672/ofm

# KYC/Identity Verification
ONFIDO_API_TOKEN=test_...
ONFIDO_REGION=EU

# Webhooks
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=5000

# CDN Configuration
CDN_ENABLED=false
CDN_URL=https://cdn.yourdomain.com
CDN_PROVIDER=cloudfront

# Live streaming
# Origin allowed by the WebSocket gateways (/messaging, /streaming)
FRONTEND_URL=http://localhost:3000
# Base URL used to build LiveStream.streamUrl (RTMP ingest, optional)
STREAM_BASE_URL=rtmp://localhost:1935/live
# WebRTC ICE servers returned by GET /streaming/ice-servers.
# STUN (comma separated, defaults to Google's public STUN servers)
STUN_URLS=
# TURN relay for viewers behind strict NAT / corporate firewalls (recommended in
# production). Comma separated, e.g.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# TURN_SECRET must equal coturn's static-auth-secret (use-auth-secret): the API
# hands out short-lived credentials (6 h), the secret never reaches browsers.
TURN_URLS=
TURN_SECRET=

# LiveKit SFU (video of the lives). With the 3 variables below set, the creator
# uploads its video once to LiveKit, which forwards it to every viewer with
# simulcast (adaptive quality): needed beyond ~15 viewers per live. Leave them
# empty to keep the peer-to-peer mesh (the creator's browser sends one copy per
# viewer). `npm run dev:up` sets them for the ofm-livekit Docker container.
# LIVEKIT_URL is the public ws(s):// URL given to browsers (wss:// in production).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: URL the API uses for LiveKit's room service (defaults to LIVEKIT_URL
# with http(s)://), e.g. http://livekit:7880 on a private network.
# LIVEKIT_API_URL=
# LiveKit webhooks (number of viewers connected to the video): point LiveKit's
# webhook.urls to <API>/api/v1/webhooks/livekit, with webhook.api_key = LIVEKIT_API_KEY.

# Content compliance (see docs/COMPLIANCE_CONTENT.md)
# Every content is reviewed by a moderator before it goes live (card network
# rules for adult content). CONTENT_PREMODERATION=false publishes right away:
# LOCAL DEVELOPMENT ONLY, ignored when NODE_ENV=production.
CONTENT_PREMODERATION=true
# Known-illegal-media (CSAM) hash matching of uploaded images / videos:
# none (default: media marked SKIPPED, warning in production) | http |
# thorn-safer | photodna. The HTTP provider is a stub to adapt to the real
# API contract once signed with the provider.
MEDIA_SCAN_PROVIDER=none
MEDIA_SCAN_API_URL=
MEDIA_SCAN_API_KEY=
# Send the file bytes (base64), not only its SHA-256 / MD5 hashes
MEDIA_SCAN_SEND_BYTES=false
MEDIA_SCAN_TIMEOUT_MS=15000
