# FanVIP - Environment Variables Template
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://ofm_user:ofm_password_dev_only@localhost:5432/ofm_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_dev_only
REDIS_DB=0

# JWT
# IMPORTANT: Generate strong secrets for production!
# openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payments (fans pay the platform through the provider, creators are paid by SEPA transfer)
# fake = local payment simulator (default outside production), ccbill = CCBill
PAYMENT_PROVIDER=fake
# Platform fee on prices excluding VAT (percent), editable from /admin/settings
PLATFORM_FEE_PERCENTAGE=15
# Days a creator earning stays on hold before it can be paid out
EARNINGS_HOLD_DAYS=7
MINIMUM_PAYOUT_AMOUNT=50
# CCBill (only with PAYMENT_PROVIDER=ccbill), see docs/PAIEMENTS.md
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUBACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_DATALINK_USERNAME=
CCBILL_DATALINK_PASSWORD=
# Secret appended to the webhook URL configured at CCBill: /api/v1/webhooks/payments/ccbill?token=...
CCBILL_WEBHOOK_TOKEN=
# Platform bank account debited by the SEPA payout files
PAYOUT_DEBTOR_NAME=
PAYOUT_DEBTOR_IBAN=
PAYOUT_DEBTOR_BIC=
# Encryption of sensitive data at rest (creators' IBAN). Keep it secret and backed up:
# changing or losing it makes stored IBANs unreadable. openssl rand -base64 32
DATA_ENCRYPTION_KEY=dev-only-encryption-key-change-me

# AWS S3 (Production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=ofm-content-prod
# AWS_REGION=eu-west-1

# MinIO (Development - S3 compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_dev_only
AWS_S3_BUCKET=ofm-content-dev
AWS_REGION=eu-west-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_only
MINIO_USE_SSL=false

# Email (Development - MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ofm.com
SMTP_FROM_NAME=FanVIP

# Email (Production - SendGrid)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key

# Email notes:
# - Leave SMTP_HOST empty to log emails to the console instead of sending them
#   (emails are never sent when NODE_ENV=test).
# - SMTP_SECURE=true forces TLS (defaults to true only when SMTP_PORT=465).
# - Links in emails (verification, password reset) point to WEB_URL.
SMTP_SECURE=false

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
# Leave empty to disable web push delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ofm.com

# Twilio (SMS/2FA)
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Sentry
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Content Security
WATERMARK_TEXT=FanVIP
WATERMARK_ENABLED=true
MAX_FILE_SIZE_MB=500
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm
ALLOWED_AUDIO_FORMATS=mp3,wav,aac,m4a

# Content Moderation
CONTENT_MODERATION_ENABLED=true
NSFW_DETECTION_ENABLED=true
CSAM_DETECTION_ENABLED=true

# Session
SESSION_SECRET=your-session-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Feature Flags
ENABLE_LIVE_STREAMING=false
ENABLE_CRYPTO_PAYMENTS=false
ENABLE_STORIES=false
ENABLE_MESSAGING=true

# RabbitMQ
RABBITMQ_URL=amqp://ofm_user:rabbitmq_password_dev_only@localhost:5672/ofm

# KYC/Identity Verification
# ONFIDO_API_TOKEN=test_...
# ONFIDO_REGION=EU

# Webhooks
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=5000

# CDN Configuration (Production)
CDN_ENABLED=false
CDN_URL=https://cdn.yourdomain.com
CDN_PROVIDER=cloudfront

# Live streaming
# Origin allowed by the WebSocket gateways (/messaging, /streaming)
FRONTEND_URL=http://localhost:3000
# Base URL used to build LiveStream.streamUrl (RTMP ingest, optional)
STREAM_BASE_URL=rtmp://localhost:1935/live
# Web app: WebRTC ICE servers as a JSON array of RTCIceServer (defaults to Google STUN)
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# ----- BEGIN tax (self-billing invoices, DAC7) -----
# Identity of the company operating the platform, printed on the monthly
# self-billing invoices (buyer) and on the creators' annual statements
COMPANY_NAME="FanVIP SAS"
COMPANY_ADDRESS="1 rue de l'Exemple, 75001 Paris, France"
# SIREN (9 digits) and intra-community VAT number of the company
COMPANY_SIREN=000000000
COMPANY_VAT_NUMBER=FR00000000000
# ----- END tax -----

# ----- BEGIN age verification (law n° 2024-449 "SREN", Arcom référentiel) -----
# Explicit media (content, stories, lives, message attachments) are only
# returned once the visitor's age is verified by a third-party solution.
# Provider: "dev" (simulator page /verification-age/dev, default outside
# production, refused when NODE_ENV=production) or "oidc" (certified third
# party exposing an OpenID Connect-like flow, see below).
AGE_VERIFICATION_PROVIDER=dev
# Validity of a verification. LEGAL: defaults to be confirmed by the lawyer
# against the Arcom référentiel (required re-verification frequency).
# Anonymous visitor's token, in minutes (default 60)
AGE_VERIFICATION_TTL_MINUTES=60
# Logged-in user (User.ageVerifiedAt), in days (default 30)
AGE_VERIFICATION_USER_TTL_DAYS=30
# HS256 secret of the anonymous age token (falls back to JWT_SECRET)
AGE_VERIFICATION_TOKEN_SECRET=change-me-age-verification-token-secret
# Optional: callback URL registered with the provider
# (default: APP_URL + /api/v1/age-verification/callback)
# AGE_VERIFICATION_CALLBACK_URL=http://localhost:3001/api/v1/age-verification/callback
# --- "oidc" provider only (values given by the provider) ---
# The provider must comply with the Arcom référentiel (double anonymity):
# check its exact protocol when signing with it.
AGE_VERIFICATION_ISSUER=
AGE_VERIFICATION_CLIENT_ID=
AGE_VERIFICATION_CLIENT_SECRET=
AGE_VERIFICATION_AUTHORIZE_URL=
AGE_VERIFICATION_TOKEN_URL=
AGE_VERIFICATION_JWKS_URL=
# Boolean claim of the ID token stating the visitor is 18 or older
AGE_VERIFICATION_CLAIM=age_over_18
AGE_VERIFICATION_SCOPE=openid
# Token endpoint authentication: client_secret_basic (default) or client_secret_post
# AGE_VERIFICATION_TOKEN_AUTH_METHOD=client_secret_basic
# Accepted ID token signature algorithms, comma separated (default: any asymmetric one)
# AGE_VERIFICATION_ALLOWED_ALGS=RS256,ES256
# ----- END age verification -----
