# ======================
# FanVIP - Production Environment Variables
# ======================

# Node Environment
NODE_ENV=production

# ======================
# Database Configuration
# ======================
DATABASE_URL=postgresql://ofm_user:CHANGE_ME@postgres:5432/ofm?schema=public
POSTGRES_DB=ofm
POSTGRES_USER=ofm_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ======================
# Redis Configuration
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ======================
# JWT Configuration
# ======================
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# API Configuration
# ======================
API_PORT=3001
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ======================
# Web Configuration
# ======================
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ======================
# Payments (CCBill), see docs/PAIEMENTS.md
# ======================
PAYMENT_PROVIDER=ccbill
PLATFORM_FEE_PERCENTAGE=15
EARNINGS_HOLD_DAYS=7
MINIMUM_PAYOUT_AMOUNT=50
CCBILL_ACCOUNT_NUMBER=CHANGE_ME
CCBILL_SUBACCOUNT=CHANGE_ME
CCBILL_FLEXFORM_ID=CHANGE_ME
CCBILL_SALT=CHANGE_ME
CCBILL_DATALINK_USERNAME=CHANGE_ME
CCBILL_DATALINK_PASSWORD=CHANGE_ME
# Long random secret, also put in the webhook URL configured at CCBill
CCBILL_WEBHOOK_TOKEN=CHANGE_ME
# Optional: comma-separated CIDR ranges allowed to send webhooks (defaults to CCBill's)
# CCBILL_WEBHOOK_ALLOWED_IPS=

# Platform bank account debited by the SEPA payout files (creators' payouts)
PAYOUT_DEBTOR_NAME=CHANGE_ME
PAYOUT_DEBTOR_IBAN=CHANGE_ME
PAYOUT_DEBTOR_BIC=CHANGE_ME

# Encryption of creators' IBANs at rest: openssl rand -base64 32 (secret manager, backed up)
DATA_ENCRYPTION_KEY=CHANGE_ME

# ======================
# AWS / S3 Configuration
# ======================
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
AWS_S3_BUCKET=ofm-uploads-prod
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
CDN_URL=https://cdn.yourdomain.com

# MinIO (if using MinIO instead of AWS S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ======================
# Email Configuration
# ======================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SENDGRID_API_KEY
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=FanVIP

# ======================
# Monitoring - Sentry
# ======================
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID

# ======================
# Push Notifications
# ======================
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY

# ======================
# SSL/TLS Configuration
# ======================
SSL_CERT_EMAIL=admin@yourdomain.com
DOMAIN_NAME=yourdomain.com

# ======================
# CDN Configuration
# ======================
# CloudFlare
CLOUDFLARE_API_KEY=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_EMAIL=admin@yourdomain.com

# CloudFront (if using AWS)
CLOUDFRONT_DISTRIBUTION_ID=CHANGE_ME
CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ======================
# Session Configuration
# ======================
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS

# ======================
# Feature Flags
# ======================
ENABLE_REGISTRATION=true
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_KYC=true

# ======================
# Backup Configuration
# ======================
BACKUP_DIR=/var/backups/ofm-database
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=ofm-backups-prod

# ======================
# Analytics
# ======================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=XXXXXXXXXXXX

# ======================
# Security
# ======================
CORS_ORIGIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ======================
# Platform Configuration
# ======================
PLATFORM_FEE_PERCENTAGE=15
MINIMUM_PAYOUT_AMOUNT=50
CURRENCY=EUR

# ======================
# Deployment
# ======================
DEPLOY_HOST=your-server-ip
DEPLOY_USER=deploy
# DEPLOY_SSH_KEY is stored in GitHub Secrets

# ======================
# Slack Notifications (optional)
# ======================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ======================
# Tax (self-billing invoices, DAC7) — BEGIN
# ======================
# Legal identity of the operating company, printed on the self-billing
# invoices and annual statements: must match the Kbis exactly
COMPANY_NAME=CHANGE_ME
COMPANY_ADDRESS=CHANGE_ME
COMPANY_SIREN=CHANGE_ME
COMPANY_VAT_NUMBER=CHANGE_ME
# ======================
# Tax — END
# ======================

# ======================
# Age verification (law n° 2024-449 "SREN", Arcom référentiel) — BEGIN
# ======================
# "oidc" only in production ("dev" is a simulator and is refused). Until
# the provider below is configured, explicit media stay hidden to everyone
# but staff and creators viewing their own content.
AGE_VERIFICATION_PROVIDER=oidc
# LEGAL: validity to be confirmed by the lawyer against the Arcom
# référentiel (required re-verification frequency) before going live.
AGE_VERIFICATION_TTL_MINUTES=60
AGE_VERIFICATION_USER_TTL_DAYS=30
# Dedicated secret (openssl rand -base64 48), distinct from JWT_SECRET
AGE_VERIFICATION_TOKEN_SECRET=CHANGE_ME
# Must match the redirect URI registered with the provider
AGE_VERIFICATION_CALLBACK_URL=https://api.CHANGE_ME/api/v1/age-verification/callback
# Certified third party complying with the référentiel (double anonymity):
# its exact protocol (endpoints, claim, client authentication) must be
# checked against its documentation when signing the contract.
AGE_VERIFICATION_ISSUER=CHANGE_ME
AGE_VERIFICATION_CLIENT_ID=CHANGE_ME
AGE_VERIFICATION_CLIENT_SECRET=CHANGE_ME
AGE_VERIFICATION_AUTHORIZE_URL=CHANGE_ME
AGE_VERIFICATION_TOKEN_URL=CHANGE_ME
AGE_VERIFICATION_JWKS_URL=CHANGE_ME
AGE_VERIFICATION_CLAIM=age_over_18
AGE_VERIFICATION_SCOPE=openid
AGE_VERIFICATION_TOKEN_AUTH_METHOD=client_secret_basic
AGE_VERIFICATION_ALLOWED_ALGS=RS256,ES256
# ======================
# Age verification — END
# ======================
