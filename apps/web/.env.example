NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_NAME=FanVIP
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: web push VAPID public key (otherwise fetched from GET /notifications/push/vapid-public-key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Live streaming (WebRTC). JSON array of RTCIceServer; defaults to Google STUN.
# Add a TURN server for viewers behind restrictive NATs, e.g.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
